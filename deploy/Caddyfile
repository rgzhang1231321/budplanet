# Caddyfile —— MedBox 边缘反向代理（腾讯云 TrustAsia 证书）
#
# 证书来自腾讯云 SSL（CN=api.apiyun.net，SAN: api.apiyun.net），
# 由 compose 挂进容器 /etc/caddy/certs/，不走 ACME 自动签发：
#   * 大陆机房申请 Let's Encrypt 有被墙/超时风险，现成证书更快更稳
#   * 证书 2027-01-30 到期，换新后 edge-up.sh（或 --recreate）即可
#
# 前置条件：域名 A 记录指向本机、安全组放行 80/443、域名已备案。

{
	# 必须保留 admin API（容器内 localhost:2019）：
	# edge-up.sh 用 `caddy reload` 热加载配置，admin off 会让 reload 直接失败
	admin localhost:2019
}

# 正式入口：小程序 request 合法域名填 https://api.apiyun.net
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy medbox-api:5080 {
		# 让后端拿到真实客户端 IP（Program.cs 已启用 ForwardedHeaders，
		# 否则 app_logs 里 IP 全是网关地址，排查用户问题时分不清人）
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}

	log {
		output stdout
		format console
		level INFO
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	tls /etc/caddy/certs/api.apiyun.net_bundle.crt /etc/caddy/certs/api.apiyun.net.key
}

# 说明：本证书 SAN 仅 api.apiyun.net（不含 www），故不设 www 区块；
# 微信小程序 request 合法域名也只登记 https://api.apiyun.net。
