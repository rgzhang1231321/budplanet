# ── MedBox 生产环境变量（模板）────────────────────────────────────────
# 复制为 deploy/.env 后使用；setup-host.sh 会自动生成随机密码。
# .env 已在 .gitignore 里，永远不会进仓库。

# ── 目录 ─────────────────────────────────────────────────────────────
# 数据盘挂载点（腾讯云建议单独挂一块云硬盘到 /data）
DATA_ROOT=/data/medbox
# 代码与编排文件所在目录（setup 时用来校验，一般不用改）
MEDBOX_HOME=/opt/medbox

# ── 数据库 ───────────────────────────────────────────────────────────
POSTGRES_DB=medbox
POSTGRES_USER=medbox
# setup-host.sh 首次会写成 48 位随机串，不要手改成弱口令
POSTGRES_PASSWORD=__GENERATED__
# 宿主机回环端口（只给本机调试/备份用，公网访问不到）
PG_PORT=5432
DB_CONTAINER=medbox-db

# ── API ──────────────────────────────────────────────────────────────
API_IMAGE=medbox-api:latest
API_CONTAINER=medbox-api
# 只绑回环，前面用 Caddy 上 HTTPS；临时自测才改 0.0.0.0:5080
API_BIND=127.0.0.1:5080
# setup-host.sh 首次会写成 48 字节随机串；上线后不要再改（会让所有旧 token 失效）
JWT__SECRET=__GENERATED__

# ── 域名 / HTTPS ─────────────────────────────────────────────────────
# 微信小程序要求 HTTPS + 已备案域名，且不能带端口。
# 证书是腾讯云签发的 api.apiyun.net（SAN 仅该域），原地放在 deploy/api.apiyun.net_nginx/：
#   *_bundle.crt 公开证书链 → .gitignore 白名单放行，可以进仓库
#   *.key        私钥        → .gitignore 挡死（*.key），不进仓库，新机器要手工拷（见 README 4.1）
# 到期 2027-01-30，换证书后重跑 edge-up.sh 即可。
DOMAIN=api.apiyun.net

# ── 容器资源上限（1G 机型按这个配，4G 机器可整体放大）────────────────
DB_MEM_LIMIT=420m
API_MEM_LIMIT=420m
EDGE_MEM_LIMIT=96m
# CPU 上限（2 核机器）：三者之和 1.80 核，刻意留 0.2 核给 sshd/dockerd，
# 否则发版或慢查询把 CPU 跑满时 SSH 挤不进去，只能去控制台救。
DB_CPU_LIMIT=0.75
API_CPU_LIMIT=0.75
EDGE_CPU_LIMIT=0.30

# ── 微信小程序 ───────────────────────────────────────────────────────
WX__APPID=wx14b8533dcc7839d1
# ★ 生产必填（不是可选项）：小程序后台 → 开发管理 → 开发设置 → AppSecret
#   空着只够 Development 用（走固定 openid 降级，只适合单机自测）；
#   **Production 下留空会直接拒绝启动**（防所有用户塌成同一个 openid、能看到别人家的记录）。
# deploy/api-up.sh 会在构建前就检查这一项，不会让你白等到健康检查超时才发现。
WX__SECRET=

# ── Worker ───────────────────────────────────────────────────────────
WORKERS__ENABLED=true
