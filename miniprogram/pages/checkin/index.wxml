<view class="p-root {{elder ? 'elder' : ''}} ckroot">
  <!-- 不传 bg：底色由 .nav 的 var(--bg-page) 决定，老人端自动跟随 .p-root.elder 的 #ffffff -->
  <page-nav title="{{elder ? '' : '该吃药了'}}" back="{{!elder}}">
    <view slot="right">
      <view class="nav-act" bindtap="onSettings"><view class="i i-gear i--lg"></view></view>
    </view>
  </page-nav>

  <!-- ── P0-4 还没到点：主按钮降级，避免老人提前服药 ── -->
  <view wx:if="{{viewState === 'pending' && early}}" class="ck">
    <view class="ck__head">
      <text class="ck__summary">{{summaryText}}</text>
    </view>

    <view class="ck__card">
      <block wx:if="{{!batch}}">
        <text class="ck__name">{{list[0].medicine_name}}</text>
        <text class="ck__dose">{{list[0].dose_text}}</text>
        <view wx:if="{{list[0].note}}" class="ck__note"><text>{{list[0].note}}</text></view>
        <view class="ck__badge"><status-badge status="pending" big="{{true}}"></status-badge></view>
      </block>
      <block wx:else>
        <view wx:for="{{list}}" wx:key="dose_id" class="ck__brow">
          <text class="ck__bname">{{item.medicine_name}}</text>
          <text class="ck__bdose">{{item.dose_text}}</text>
        </view>
        <view wx:if="{{folded}}" class="ck__fold">等 {{extra}} 种药</view>
      </block>
    </view>

    <view class="ck__early">
      <text class="ck__early-t">还没到点</text>
      <text class="ck__early-d">还有 {{earlyText}}</text>
    </view>

    <view class="ck__actions">
      <view class="ck__early-btn"><text>还没到点</text></view>
      <view class="ck__early-link" bindtap="onTake"><text>我提前吃了</text></view>
      <text wx:if="{{nextText}}" class="ck__who">{{nextText}}</text>
    </view>
  </view>

  <!-- ── P11 待打卡 ── -->
  <view wx:elif="{{viewState === 'pending'}}" class="ck">
    <view class="ck__head">
      <text wx:if="{{elder}}" class="ck__summary">{{summaryText}}</text>
      <text class="ck__when">{{headText}}</text>
      <text wx:if="{{showProgress}}" class="ck__prog">{{progressText}}</text>
    </view>

    <view class="ck__card">
      <block wx:if="{{!batch}}">
        <text class="ck__name">{{list[0].medicine_name}}</text>
        <text class="ck__dose">{{list[0].dose_text}}</text>
        <view wx:if="{{list[0].note}}" class="ck__note"><text>{{list[0].note}}</text></view>
        <view class="ck__badge"><status-badge status="pending" big="{{true}}"></status-badge></view>
      </block>
      <block wx:else>
        <view wx:for="{{list}}" wx:key="dose_id" class="ck__brow">
          <text class="ck__bname">{{item.medicine_name}}</text>
          <text class="ck__bdose">{{item.dose_text}}</text>
        </view>
        <view wx:if="{{folded}}" class="ck__fold">等 {{extra}} 种药</view>
      </block>
    </view>

    <view class="ck__actions">
      <primary-button label="{{btnLabel}}" bind:tap="onTake"></primary-button>
      <text wx:if="{{lastOne}}" class="ck__last">今天最后一次了</text>

      <view wx:if="{{!batch}}" class="ck__subs">
        <view class="ck__sub" hover-class="ck__sub--hover" bindtap="onSnooze">
          <text class="ck__sub-t">稍后提醒</text>
          <text class="ck__sub-d">15 分钟</text>
        </view>
        <view class="ck__sub" hover-class="ck__sub--hover" bindtap="onSkip">
          <text class="ck__sub-t">今天不吃</text>
        </view>
      </view>

      <view wx:if="{{showCountdown}}" class="ck__cd">
        <text class="ck__cd-t">还有</text>
        <text class="ck__cd-n">{{countdownText}}</text>
        <text class="ck__cd-t">提醒你吃药</text>
      </view>

      <text class="ck__who">{{whoText}}</text>
    </view>
  </view>

  <!-- ── P12 打卡成功 ── -->
  <view wx:elif="{{viewState === 'taken'}}" class="ok">
    <view class="ok__ring">
      <view class="ok__wave"></view>
      <view class="i i-check-green ok__check"></view>
    </view>
    <text class="ok__title">已经记下了</text>
    <text class="ok__sub">{{subText}}</text>
    <text wx:if="{{quotaHint}}" class="ok__quota">{{quotaHint}}</text>

    <view class="ok__stack"><member-avatar-stack members="{{members}}"></member-avatar-stack></view>
    <text class="ok__known">{{knownText}}</text>

    <view class="ok__share">
      <share-cta style="flex:1" elder="{{elder}}" bind:sharetap="onShareTap"></share-cta>
    </view>

    <view wx:if="{{canUndo}}" class="ok__undo" bindtap="onUndo"><text>撤销</text></view>

    <view class="ok__back" bindtap="goHome"><text>返回今日</text></view>

    <view class="ok__ad">
      <ad-slot adOn="{{adOn}}" unitId="{{adUnitA}}" slot="a" height="{{210}}" elder="{{elder}}"></ad-slot>
    </view>
  </view>

  <!-- ── 漏服 / 跳过：只说事实 + 契约允许的出路（不许渲染成打卡成功） ── -->
  <view wx:elif="{{viewState === 'missed'}}" class="ck">
    <view class="ck__head">
      <text class="ck__when">{{headText}}</text>
    </view>

    <view class="ck__card">
      <text class="ck__name">{{list[0].medicine_name}}</text>
      <text class="ck__dose">{{list[0].dose_text}}</text>
      <view class="ck__badge"><status-badge status="{{list[0].status}}" big="{{true}}"></status-badge></view>
    </view>

    <view class="ck__actions">
      <view class="col t-center">
        <text class="ck__empty-t">{{missTitle}}</text>
        <text class="ck__empty-d mt-2">{{missWhy}}</text>
      </view>
      <view class="mt-5">
        <primary-button wx:if="{{canMakeup}}" label="确实吃了，补记" bind:tap="onMakeup"></primary-button>
        <primary-button wx:else label="返回今日" bind:tap="goHome"></primary-button>
      </view>
      <text class="ck__who">{{whoText}}</text>
    </view>
  </view>

  <!-- ── ?dose= 指向的那条已不在今天的清单里（改了计划会生成新 dose_id） ── -->
  <view wx:elif="{{viewState === 'stale'}}" class="ck">
    <view class="ck__empty">
      <text class="ck__empty-t">这条已经更新了</text>
      <text class="ck__empty-d">药单刚改过，这条记录不在今天的清单里了。回今日看最新的那条。</text>
    </view>
    <view class="ck__actions">
      <primary-button label="返回今日" bind:tap="goHome"></primary-button>
      <text class="ck__who">也可以下拉刷新</text>
    </view>
  </view>

  <!-- ── 正在拉今天的药：数据没到之前不下任何结论 ── -->
  <view wx:elif="{{viewState === 'loading'}}" class="ck">
    <view class="ck__empty">
      <text class="ck__empty-t">正在看看今天的药</text>
      <text class="ck__empty-d">稍等一下就好</text>
    </view>
  </view>

  <!-- ── 今天确实没有排药（真空态；"都记好了"是另一件事，不能拿这句顶） ── -->
  <view wx:else class="ck">
    <view class="ck__empty">
      <text class="ck__empty-t">今天还没有安排</text>
      <text class="ck__empty-d">还没设今天的药和时间，设好之后到点会提醒</text>
    </view>
    <view class="ck__actions">
      <primary-button label="返回今日" bind:tap="goHome"></primary-button>
    </view>
  </view>

  <toast-bar show="{{syncShow}}" state="{{syncState}}" bind:retry="onRetrySync"></toast-bar>
</view>
