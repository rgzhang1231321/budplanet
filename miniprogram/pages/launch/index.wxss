.launch {
  --fs-hero: 60rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--bg-page);
}

/* ── P00 ── */
.hero {
  padding-left: var(--pad-page);
  padding-right: var(--pad-page);
  padding-bottom: 120rpx;
  background: linear-gradient(160deg, #2e6be6 0%, #1e4fbf 55%, #17409c 100%);
  border-radius: 0 0 48rpx 48rpx;
}
.hero__logo {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--sp-5);
}
.hero__logo-icon {
  width: 56rpx;
  height: 56rpx;
  filter: brightness(0) invert(1);
}
.hero__title {
  display: block;
  margin-top: var(--sp-4);
  font-size: var(--fs-hero);
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}
.hero__sub {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-body);
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.5;
}

.demo-wrap {
  margin-top: -84rpx;
}
.demo {
  background: #ffffff;
  border-radius: var(--r-l);
  box-shadow: 0 12rpx 40rpx rgba(17, 34, 51, 0.12);
  padding: var(--sp-4);
}
.demo__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.demo__date {
  font-size: var(--fs-caption);
  color: var(--text-3);
}
.demo__rate {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--brand-600);
}
.demo__bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: #e8edf2;
  margin: var(--sp-2) 0 var(--sp-3);
  overflow: hidden;
}
.demo__bar-in {
  width: 50%;
  height: 100%;
  background: var(--brand-500);
  border-radius: 4rpx;
}
.demo__row {
  display: flex;
  align-items: center;
  height: 84rpx;
  border-top: 1rpx solid var(--line);
}
.demo__time {
  width: 104rpx;
  font-size: var(--fs-caption);
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}
.demo__med {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--text-1);
}
.demo__badge {
  font-size: var(--fs-micro);
  color: var(--text-3);
  padding: 4rpx 12rpx;
  border-radius: var(--r-full);
  background: #f3f6f9;
}
.demo__badge--ok {
  color: var(--st-taken-text);
  background: var(--st-taken-bg);
}
.demo__badge--miss {
  color: var(--st-missed-text);
  background: var(--danger-bg);
}

.props {
  margin-top: var(--sp-5);
}
.props__item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.props__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-500);
  margin-right: 16rpx;
  flex: none;
}
.props__t {
  font-size: var(--fs-body);
  color: var(--text-2);
  line-height: 1.5;
}

.foot {
  padding-top: var(--sp-5);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--sp-5));
}
.foot__note {
  display: block;
  margin-top: var(--sp-3);
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-3);
}
/* 隐私政策 / 用户协议：一眼能找到，但不抢主按钮 */
.foot__legal {
  margin-top: var(--sp-4);
  display: flex;
  align-items: center;
  justify-content: center;
}
.foot__legal-link {
  padding: 0 var(--sp-3);
  font-size: var(--fs-caption);
  color: var(--text-3);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

/* 「我有邀请码」：次级入口，不能和「开始使用」抢注意力，但要让手指好点 */
.manual {
  margin-top: var(--sp-3);
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.manual--hover {
  opacity: 0.6;
}
.manual__t {
  font-size: var(--fs-body-s);
  color: var(--brand-600);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

/* ── P01 ── */
.mode {
  padding-left: var(--pad-page);
  padding-right: var(--pad-page);
  padding-bottom: var(--sp-6);
}
.mode__title {
  display: block;
  font-size: var(--fs-num-s);
  font-weight: 700;
  color: var(--text-1);
}
.mode__sub {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-body);
  color: var(--text-2);
}
.mode__ivt {
  margin-top: var(--sp-3);
  padding: 12rpx var(--sp-3);
  background: var(--brand-100);
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mode__ivt-code {
  font-size: var(--fs-caption);
  color: var(--brand-600);
  letter-spacing: 1rpx;
}
.mode__ivt-edit {
  font-size: var(--fs-caption);
  color: var(--brand-600);
  text-decoration: underline;
  text-underline-offset: 4rpx;
}
.mode__card {
  margin-top: var(--sp-4);
  background: #ffffff;
  border-radius: var(--r-xl);
  padding: var(--sp-5);
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-1);
  border: 1rpx solid #eef2f6;
}
.mode__card--hover {
  background: #f8fafc;
}
.mode__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--brand-100);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.mode__icon--elder {
  background: #fdf1e6;
}
.mode__text {
  flex: 1;
  margin-left: var(--sp-3);
  display: flex;
  flex-direction: column;
}
.mode__name {
  font-size: var(--fs-emph);
  font-weight: 600;
  color: var(--text-1);
}
.mode__desc {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
}
.mode__hint {
  display: block;
  margin-top: var(--sp-5);
  font-size: var(--fs-caption);
  color: var(--text-3);
  text-align: center;
  line-height: 1.6;
}

/* ── P42 落地页（老人规格，一屏装完不滚动） ── */
.p42 {
  min-height: 100vh;
  padding-left: 40rpx;
  padding-right: 40rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #ffffff;
}
.p42__close {
  width: 88rpx;
  height: 88rpx;
  margin-left: -20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.p42__kicker {
  margin-top: 8rpx;
  font-size: var(--fs-body);
  color: #414d5a;
  line-height: 1.4;
}
.p42__title {
  margin-top: 8rpx;
  font-size: var(--fs-display);
  font-weight: 700;
  color: #0f1620;
  line-height: 1.2;
}
.p42__list {
  margin-top: 40rpx;
  background: #f7f9fb;
  border-radius: 32rpx;
  padding: 8rpx 32rpx;
}
.p42__item {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 1rpx solid #e8edf2;
}
.p42__item:last-child {
  border-bottom: none;
}
.p42__time {
  width: 132rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: #0f1620;
  font-variant-numeric: tabular-nums;
}
.p42__med {
  flex: 1;
  font-size: var(--fs-body);
  color: #0f1620;
}
.p42__dose {
  font-size: var(--fs-body);
  font-weight: 600;
  color: #1e4fbf;
}
.p42__more {
  height: 96rpx;
  display: flex;
  align-items: center;
  font-size: var(--fs-caption);
  color: #414d5a;
}
.p42__line {
  margin-top: 32rpx;
  font-size: var(--fs-caption);
  color: #414d5a;
  line-height: 1.6;
}
.p42__actions {
  margin-top: auto;
  padding-bottom: 24rpx;
}
.p42__main {
  height: 160rpx;
  font-size: var(--fs-btn);
}
.p42__tip {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--fs-caption);
  color: #414d5a;
}
.p42__second {
  margin-top: 40rpx;
  height: 120rpx;
  border: 2rpx solid var(--brand-500);
  color: var(--brand-600);
  font-size: var(--fs-body-s);
}
.p42__tip2 {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: var(--fs-caption);
  color: #414d5a;
}
.p42__bar {
  margin: 24rpx -40rpx 0;
  padding-bottom: env(safe-area-inset-bottom);
}
