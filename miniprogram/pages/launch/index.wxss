.launch {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--bg-page);
}

.foot {
  padding-top: var(--sp-5);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--sp-5));
}
.foot__note {
  display: block;
  /* 与上面的法务链接拉开一档：两条挨在一起会被读成同一句话 */
  margin-top: var(--sp-2);
  text-align: center;
  font-size: var(--fs-foot);
  color: var(--text-2);
}
/* 隐私政策 / 用户协议：一眼能找到，但不抢上面的身份卡片 */
.foot__legal {
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 点击目标挂在 item 上：命中盒 = item 整块矩形，才够 44px 老人点得准 */
.foot__legal-item {
  display: flex;
  align-items: center;
  min-height: var(--h-tap);
  padding: 0 var(--sp-3);
}
.foot__legal-item--hover {
  background: var(--bg-page);
  border-radius: var(--r-s);
}
.foot__legal-link {
  font-size: var(--fs-foot);
  color: var(--text-2);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

/* 「我有邀请码」：次级入口，不能和「开始使用」抢注意力，但要让手指好点 */
.manual {
  margin-top: var(--sp-3);
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.manual--hover {
  opacity: 0.6;
}
.manual__t {
  font-size: var(--fs-body-s);
  color: var(--text-2);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

/* ── P01 ── */
.mode {
  padding-left: var(--pad-page);
  padding-right: var(--pad-page);
  padding-bottom: var(--sp-6);
}
.mode__title {
  display: block;
  font-size: var(--fs-num-s);
  font-weight: 700;
  color: var(--text-1);
}
.mode__sub {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-body);
  color: var(--text-2);
}
.mode__ivt {
  margin-top: var(--sp-3);
  padding: 12rpx var(--sp-3);
  background: var(--brand-100);
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mode__ivt-code {
  font-size: var(--fs-caption);
  color: var(--brand-600);
  letter-spacing: 1rpx;
}
.mode__ivt-edit {
  font-size: var(--fs-caption);
  color: var(--brand-600);
  text-decoration: underline;
  text-underline-offset: 4rpx;
}
.mode__card {
  margin-top: var(--sp-4);
  background: #ffffff;
  border-radius: var(--r-xl);
  padding: var(--sp-5);
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-1);
  border: 1rpx solid #eef2f6;
}
.mode__card--hover {
  background: #f8fafc;
}
.mode__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--brand-100);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.mode__icon--elder {
  background: #fdf1e6;
}
.mode__text {
  flex: 1;
  margin-left: var(--sp-3);
  display: flex;
  flex-direction: column;
}
.mode__name {
  font-size: var(--fs-emph);
  font-weight: 600;
  color: var(--text-1);
}
.mode__desc {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--text-2);
}
.mode__hint {
  display: block;
  margin-top: var(--sp-5);
  font-size: var(--fs-caption);
  color: var(--text-2);
  text-align: center;
  line-height: 1.6;
}

/* ── P42 落地页（老人规格，一屏装完不滚动） ── */
.p42 {
  min-height: 100vh;
  padding-left: 40rpx;
  padding-right: 40rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #ffffff;
}
.p42__close {
  width: 88rpx;
  height: 88rpx;
  margin-left: -20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.p42__kicker {
  margin-top: 8rpx;
  font-size: var(--fs-body);
  color: #414d5a;
  line-height: 1.4;
}
.p42__title {
  margin-top: 8rpx;
  font-size: var(--fs-display);
  font-weight: 700;
  color: #0f1620;
  line-height: 1.2;
}
.p42__list {
  margin-top: 40rpx;
  background: #f7f9fb;
  border-radius: 32rpx;
  padding: 8rpx 32rpx;
}
.p42__item {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 1rpx solid #e8edf2;
}
.p42__item:last-child {
  border-bottom: none;
}
.p42__time {
  width: 132rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: #0f1620;
  font-variant-numeric: tabular-nums;
}
.p42__med {
  flex: 1;
  font-size: var(--fs-body);
  color: #0f1620;
}
.p42__dose {
  font-size: var(--fs-body);
  font-weight: 600;
  color: #1e4fbf;
}
.p42__more {
  height: 96rpx;
  display: flex;
  align-items: center;
  font-size: var(--fs-caption);
  color: #414d5a;
}
.p42__line {
  margin-top: 32rpx;
  font-size: var(--fs-caption);
  color: #414d5a;
  line-height: 1.6;
}
.p42__actions {
  margin-top: auto;
  padding-bottom: 24rpx;
}
.p42__main {
  height: 160rpx;
  font-size: var(--fs-btn);
}
.p42__tip {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--fs-caption);
  color: #414d5a;
}
.p42__second {
  margin-top: 40rpx;
  height: 120rpx;
  border: 2rpx solid var(--brand-500);
  color: var(--brand-600);
  font-size: var(--fs-body-s);
}
.p42__tip2 {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: var(--fs-caption);
  color: #414d5a;
}
.p42__bar {
  margin: 24rpx -40rpx 0;
  padding-bottom: env(safe-area-inset-bottom);
}
