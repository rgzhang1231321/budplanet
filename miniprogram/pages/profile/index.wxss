.me {
  display: flex;
  align-items: center;
  padding: var(--sp-4) 0 var(--sp-5);
}
.me__avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2e6be6, #1e4fbf);
  color: #ffffff;
  font-size: var(--fs-icon);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.p-root.elder .me__avatar {
  width: 140rpx;
  height: 140rpx;
  
}
.me__text {
  margin-left: var(--sp-3);
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.me__name {
  font-size: var(--fs-h1);
  font-weight: 700;
  color: var(--text-1);
}
.me__sub {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--text-2);
}

.quota-card {
  background: var(--bg-card);
  border-radius: var(--r-l);
  box-shadow: var(--shadow-1);
  padding: var(--sp-4);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.quota-card__left {
  display: flex;
  flex-direction: column;
}
.quota-card__num {
  font-size: var(--fs-num-m);
  font-weight: 700;
  color: var(--text-1);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.quota-card__of {
  font-size: var(--fs-body);
  font-weight: 400;
  color: var(--text-3);
}
.quota-card__label {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
}
.quota-card__btn {
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: var(--r-full);
  background: var(--brand-100);
  color: var(--brand-600);
  font-size: var(--fs-body);
  font-weight: 600;
  display: flex;
  align-items: center;
}
.list__ico {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--sp-2);
}
.list__label--danger {
  color: var(--st-missed-text);
}
.foot {
  display: block;
  margin-top: var(--sp-5);
  margin-bottom: var(--sp-4);
  text-align: center;
  font-size: var(--fs-micro);
  color: var(--text-3);
}
