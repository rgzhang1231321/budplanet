/* ── 浮层通用 ── */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--mask);
  z-index: 100;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: var(--bg-card);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  padding: var(--sp-5) var(--pad-page) calc(env(safe-area-inset-bottom) + var(--sp-5));
  box-shadow: var(--shadow-2);
}
.press {
  transition: transform 120ms ease-out;
}
.press:active {
  transform: scale(0.98);
}

/* ── 骨架屏 ── */
.sk {
  background: var(--line);
  border-radius: var(--r-m);
  animation: sk 1.2s ease-in-out infinite;
}
@keyframes sk {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}
