.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-7) var(--pad-page);
}
.empty__art {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, #eaf1fe 0%, #f6f9ff 70%, #ffffff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty__icon {
  width: 104rpx;
  height: 104rpx;
  opacity: 0.85;
}
.empty__title {
  margin-top: var(--sp-4);
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--text-1);
  text-align: center;
}
.empty__desc {
  margin-top: var(--sp-2);
  font-size: var(--fs-body);
  color: var(--text-2);
  text-align: center;
  line-height: 1.7;
  max-width: 560rpx;
  white-space: pre-line;
}
.empty__btn {
  margin-top: var(--sp-5);
  min-width: 360rpx;
  height: var(--h-main-btn);
  padding: 0 var(--sp-5);
  border-radius: var(--r-xl);
  background: var(--brand-500);
  color: #ffffff;
  font-size: var(--fs-btn);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
