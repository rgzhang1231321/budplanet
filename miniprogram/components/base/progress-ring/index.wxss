.pr {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pr__ring {
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.pr__inner {
  width: 84%;
  height: 84%;
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 8rpx rgba(17, 34, 51, 0.04);
}
.pr__num-row {
  display: flex;
  align-items: baseline;
}
.pr__num {
  font-size: 96rpx;
  font-weight: 700;
  color: var(--text-1);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.pr__pct {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-2);
  margin-left: 4rpx;
}
.pr__label {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
}
.pr__delta {
  margin-top: var(--sp-2);
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--st-taken-text);
}
.pr__delta--down {
  color: var(--st-missed-text);
}
