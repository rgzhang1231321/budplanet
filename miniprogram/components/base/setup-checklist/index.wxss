.sc {
  margin-top: var(--sp-3);
  background: var(--bg-card);
  border-radius: var(--r-l);
  box-shadow: var(--shadow-1);
  border: 1rpx solid var(--line);
  padding: var(--sp-3) var(--sp-4);
}
.sc__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sc__title {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--text-1);
}
.sc__close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
}
.sc__row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  border-top: 1rpx solid var(--line);
  margin-top: var(--sp-2);
  padding-top: var(--sp-2);
}
.sc__row:first-of-type {
  margin-top: var(--sp-3);
}
.sc__dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  font-weight: 600;
  background: var(--bg-page);
  color: var(--text-3);
  border: 1rpx solid var(--line);
}
.sc__label {
  margin-left: var(--sp-2);
  font-size: var(--fs-body);
  color: var(--text-2);
}
.sc__act {
  margin-left: auto;
  font-size: var(--fs-caption);
  color: var(--brand-600);
  font-weight: 600;
}
/* 已完成：灰字 + 删除线感 */
.sc__row--done .sc__dot {
  background: var(--st-taken-bg);
  color: var(--st-taken-text);
  border-color: transparent;
}
.sc__row--done .sc__label {
  color: var(--text-3);
  text-decoration: line-through;
}
/* 当前步：黑字加粗 */
.sc__row--active .sc__dot {
  background: var(--brand-100);
  color: var(--brand-600);
  border-color: transparent;
}
.sc__row--active .sc__label {
  color: var(--text-1);
  font-weight: 600;
}
.sc__hint {
  display: block;
  margin-top: var(--sp-3);
  font-size: var(--fs-micro);
  color: var(--text-3);
  line-height: 1.5;
}
