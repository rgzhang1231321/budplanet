.stack {
  display: flex;
  align-items: center;
  justify-content: center;
}
.stack__item,
.stack__more {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin: 0 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  background: #b9c6d6;
  border: 2rpx solid #ffffff;
}
.stack__item--lit {
  background: var(--brand-500);
  opacity: 0;
  animation: popIn 320ms ease-out forwards;
}
.stack__more {
  background: #eef2f6;
  color: var(--text-2);
}
@keyframes popIn {
  0% {
    opacity: 0;
    transform: scale(0.6);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}
