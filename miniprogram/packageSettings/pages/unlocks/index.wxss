.ov {
  background: linear-gradient(135deg, #2e6be6, #1e4fbf);  border-radius: var(--r-l);
  padding: var(--sp-5) var(--sp-4);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--sp-2);
  box-shadow: 0 10rpx 30rpx rgba(30, 79, 191, 0.22);
}
.ov__num {
  font-size: var(--fs-num-xl);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.ov__label {
  margin-top: 8rpx;
  font-size: var(--fs-body);
  color: rgba(255, 255, 255, 0.9);
}
.gs {
  display: flex;
  align-items: baseline;
  margin: var(--sp-4) 0 var(--sp-2) 4rpx;
}
.gs__t {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--text-1);
}
.gs__n {
  font-size: var(--fs-caption);
  color: var(--text-3);
}
.sub {
  margin-top: 4rpx;
  font-size: var(--fs-micro);
  color: var(--text-3);
}
.empty-wrap {
  margin-top: 8vh;
}
.list__ico {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--sp-2);
}
