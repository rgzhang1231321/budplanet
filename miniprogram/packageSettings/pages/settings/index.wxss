.gs {
  display: block;
  margin: var(--sp-4) 0 var(--sp-2) 4rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
}
.elist {
  background: var(--bg-card);
  border-radius: var(--r-l);
  border: 1rpx solid var(--line);
  overflow: hidden;
  margin-top: var(--sp-3);
}
.elist__row {
  min-height: 128rpx;
  padding: 0 var(--sp-5);
  display: flex;
  align-items: center;
  position: relative;
}
.elist__row::after {
  content: "";
  position: absolute;
  left: var(--sp-5);
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--line);
}
.elist__row:last-child::after {
  display: none;
}
.elist__label {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--text-1);
  margin-left: var(--sp-2);
}
.elist__value {
  font-size: var(--fs-body);
  color: var(--text-2);
  margin-right: var(--sp-2);
}
.ebar {
  margin: var(--sp-5) calc(-1 * var(--pad-page)) 0;
}
