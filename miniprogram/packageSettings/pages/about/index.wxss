.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-6) 0 var(--sp-4);
}
.brand__logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #2e6be6, #1e4fbf);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(30, 79, 191, 0.25);
}
.brand__icon {
  width: 64rpx;
  height: 64rpx;
  filter: brightness(0) invert(1);
}
.brand__name {
  margin-top: var(--sp-3);
  font-size: var(--fs-h1);
  font-weight: 700;
  color: var(--text-1);
}
.brand__ver {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
}
.brand__desc {
  margin-top: var(--sp-3);
  font-size: var(--fs-body);
  color: var(--text-2);
  text-align: center;
  line-height: 1.6;
}
.note {
  display: block;
  margin-top: var(--sp-4);
  padding: 0 4rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
  line-height: 1.7;
}
.bar {
  margin: var(--sp-5) calc(-1 * var(--pad-page)) 0;
}
