<view class="p-root">
  <page-nav title="{{pureElder ? '我的记录' : '历史记录'}}" back="{{true}}"></page-nav>

  <view class="page page--safe">
    <block wx:if="{{!isEmpty}}">
      <view wx:for="{{groups}}" wx:key="date" class="g">
        <view class="g__head">
          <text class="g__date">{{item.label}}</text>
          <!-- 纯服药人本人不做完成率评价，只看事实 -->
          <text wx:if="{{!pureElder}}" class="g__sum">{{item.taken}}/{{item.total}}</text>
        </view>
        <view class="list">
          <view wx:for="{{item.rows}}" wx:for-item="row" wx:key="dose_id" class="hrow">
            <text class="hrow__time">{{row.due_time}}</text>
            <view class="hrow__mid">
              <text wx:if="{{row.who}}" class="hrow__who">{{row.who}}</text>
              <text class="hrow__name">{{row.medicine_name}}</text>
            </view>
            <text class="hrow__dose">{{row.dose_text}}</text>
            <status-badge status="{{row.status}}"></status-badge>
          </view>
        </view>
      </view>
    </block>

    <empty-state
      wx:elif="{{!loading}}"
      icon="chart"
      title="还没有记录"
      desc="等第一次打卡之后，这里会按天留下痕迹"
    ></empty-state>
  </view>
</view>
