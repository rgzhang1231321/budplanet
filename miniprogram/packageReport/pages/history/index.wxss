.g {
  margin-top: var(--sp-4);
}
.g__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx var(--sp-2);
}
.g__date {
  font-size: var(--fs-body-s);
  font-weight: 600;
  color: var(--text-1);
}
.g__sum {
  font-size: var(--fs-caption);
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}
.hrow {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 var(--sp-4);
  position: relative;
}
.hrow::after {
  content: "";
  position: absolute;
  left: var(--sp-4);
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--line);
}
.hrow:last-child::after {
  display: none;
}
.hrow__time {
  width: 100rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
  flex: none;
}
.hrow__mid {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.hrow__who {
  flex: none;
  max-width: 160rpx;
  margin-right: var(--sp-1);
  padding: 0 var(--sp-1);
  border-radius: var(--r-s);
  background: var(--bg-page);
  font-size: var(--fs-caption);
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 家里只有一位服药人时，同一个名字会在整页重复 —— 去掉底色块、降一档字号，
   保留"这是谁的"信息但不和药名抢注意力。 */
.hrow__who--quiet {
  background: transparent;
  padding: 0;
  margin-right: 10rpx;
  font-weight: 400;
}
.hrow__name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 大字版（.p-root.elder）下人名 chip 收窄到 100rpx：--fs-caption 到了 36–40rpx，
   160rpx 只够 4 个字，药名被挤得只剩半截（"苯磺酸氨氯地平片"必截断）。
   普通版保持 160rpx 不动 —— 小字号下这个宽度正好放得下"爸爸/妈妈"这类两字别名。 */
.p-root.elder .hrow__who {
  max-width: 100rpx;
}
.hrow__dose {
  font-size: var(--fs-caption);
  color: var(--brand-600);
  margin: 0 var(--sp-2);
  flex: none;
}
